#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define SET  3

&lt {
    quick-tap-ms = <200>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
// ---------------------------------------------------------------------------------------------------------------------
// |  ESC  |   Q   |   W   |   E   |   R   |   T   |       |   |       |   Y   |   U   |   I   |   O   |   P   |   -   |
// |  TAB  |   A   |   S   |   D   |   F   |   G   |   F5  |   |   F2  |   H   |   J   |   K   |   L   |   ;   |   '   |
// |  CTRL |   Z   |   X   |   C   |   V   |   B   |  DEL  |   |  F12  |   N   |   M   |   ,   |   .   |   /   |   \   |
// |  SET  |  GUI  |  ALT  | SFT/L1|NUM/SPC|  NAV  |       |   |       |  NAV  |NUM/RET| SFT/L2|   [   |   ]   | SLEEP |
// SET = 設定レイヤーの切替 (左の隠しキー), SLEEP = PC をスリープ (右の隠しキー)
// SFT/L1 = tap LANG1 / hold LSHFT, SFT/L2 = tap LANG2 / hold RSHFT
// NUM/SPC, NUM/RET = tap SPACE/RET / hold NUM layer
            bindings = <
    &kp ESC      &kp Q         &kp W         &kp E            &kp R          &kp T         &none            &none     &kp Y         &kp U        &kp I            &kp O      &kp P       &kp MINUS
    &kp TAB      &kp A         &kp S         &kp D            &kp F          &kp G         &kp F5           &kp F2    &kp H         &kp J        &kp K            &kp L      &kp SEMI    &kp SQT
    &kp LCTRL    &kp Z         &kp X         &kp C            &kp V          &kp B         &kp DEL          &kp F12   &kp N         &kp M        &kp COMMA        &kp DOT    &kp FSLH    &kp BSLH
    &tog SET     &kp LGUI      &kp LALT      &mt LSHFT LANG2  &lt NUM SPACE  &mo NAV       &none            &none     &mo NAV       &lt NUM RET  &mt RSHFT LANG1  &kp LBKT   &kp RBKT    &kp C_SLEEP
            >;
        };

        nav_layer {
            display-name = "Nav";
// ---------------------------------------------------------------------------------------------------------------------
// |       |       |       |       |       |       |       |   |       |  HOME |  PGDN |  PGUP |  END  |       |       |
// |  F11  |   F1  |   F2  |   F3  |   F4  |   F5  |       |   |       |  LEFT |  DOWN |   UP  | RIGHT |       |       |
// |  F12  |   F6  |   F7  |   F8  |   F9  |   F10 |       |   |       |   {   |   }   |   [   |   ]   |       |       |
// |       |       |       |       |       |       |       |   |       |       |  BSPC |       |       |       |       |
            bindings = <
    &studio_unlock     &trans      &trans        &trans        &trans        &trans        &trans           &trans      &kp HOME      &kp PG_DN   &kp PG_UP   &kp END    &trans     &trans
    &kp F11            &kp F1      &kp F2        &kp F3        &kp F4        &kp F5        &trans           &trans      &kp LEFT      &kp DOWN    &kp UP      &kp RIGHT  &trans     &trans
    &kp F12            &kp F6      &kp F7        &kp F8        &kp F9        &kp F10       &trans           &trans      &kp LBRC      &kp RBRC    &kp LBKT    &kp RBKT   &trans     &trans
    &trans             &trans      &trans        &trans        &trans        &trans        &trans           &trans      &trans        &kp BSPC    &trans      &trans     &trans     &trans
            >;
        };

        num_layer {
            display-name = "Num";
// ---------------------------------------------------------------------------------------------------------------------
// |   ~   |   !   |   @   |   #   |   $   |   %   |       |   |       |   ^   |   &   |   *   |   (   |   )   |   +   |
// |   `   |   1   |   2   |   3   |   4   |   5   |       |   |       |   6   |   7   |   8   |   9   |   0   |   =   |
// |       |       |       |       |       |       |       |   |       |       |       |       |       |       |       |
// |       |       |       |       |       |       |       |   |       |       |       |       |       |       |       |
            bindings = <
    &kp TILDE &kp EXCL    &kp AT        &kp HASH      &kp DLLR      &kp PRCNT     &trans           &trans      &kp CARET     &kp AMPS    &kp ASTRK   &kp LPAR   &kp RPAR   &kp PLUS
    &kp GRAVE &kp N1      &kp N2        &kp N3        &kp N4        &kp N5        &trans           &trans      &kp N6        &kp N7      &kp N8      &kp N9     &kp N0     &kp EQUAL
    &trans    &trans      &trans        &trans        &trans        &trans        &trans           &trans      &trans        &trans      &trans      &trans     &trans     &trans
    &trans    &trans      &trans        &trans        &trans        &trans        &trans           &trans      &trans        &trans      &trans      &trans     &trans     &trans
            >;
        };

        set_layer {
            display-name = "Set";
// ---------------------------------------------------------------------------------------------------------------------
// 左の隠しキー (SET) で切り替え。誤入力を防ぐため、割り当てのないキーは何も入力しない。
// |       |  BT0  |  BT1  |  BT2  |  BT3  |  BT4  |       |   |       |       |       |       |       |       |       |
// |       |  USB  |  BLE  |       |       |       |       |   |       |       |       |       |       |       |       |
// |       |       |       |       |       |BT_CLR |       |   |       |       |       |       |       |       |       |
// |  BASE |       |       |       |       |       |       |   |       |       |       |       |       |       | SLEEP |
// BASE = デフォルトレイヤーに戻る (左の隠しキー)
// BT0〜4 = 接続先 PC の切り替え, BT_CLR = 選択中の接続先のペアリング解除
            bindings = <
    &none     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none            &none       &none         &none       &none       &none      &none      &none
    &none     &out OUT_USB  &out OUT_BLE  &none         &none         &none         &none            &none       &none         &none       &none       &none      &none      &none
    &none     &none         &none         &none         &none         &bt BT_CLR    &none            &none       &none         &none       &none       &none      &none      &none
    &to BASE  &none         &none         &none         &none         &none         &none            &none       &none         &none       &none       &none      &none      &kp C_SLEEP
            >;
        };
    };
};
