# ---------------------------------------------------------------------------
# PC とつながる側 (セントラル)
#   ドングルなし版: 左手側
#   ドングル版    : ドングル (左手側は build.yaml の cmake-args でペリフェラルにする)
# ---------------------------------------------------------------------------

if SHIELD_TIMOTHY_V2_LEFT || SHIELD_TIMOTHY_V2_DONGLE

config ZMK_KEYBOARD_NAME
    default "Timothy_v2"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# ペリフェラルの電池残量を取得し、PC にも通知する。
# ドングル版の左手側は cmake-args でペリフェラルにするので、セントラルのときだけ有効にする。
config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y if ZMK_SPLIT_ROLE_CENTRAL

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
    default y if ZMK_SPLIT_ROLE_CENTRAL

endif # SHIELD_TIMOTHY_V2_LEFT || SHIELD_TIMOTHY_V2_DONGLE

if SHIELD_TIMOTHY_V2_LEFT || SHIELD_TIMOTHY_V2_RIGHT || SHIELD_TIMOTHY_V2_DONGLE

config ZMK_SPLIT
    default y

endif

# ---------------------------------------------------------------------------
# ドングル: 左右の 2 台をペリフェラルとして受ける
# ---------------------------------------------------------------------------

if SHIELD_TIMOTHY_V2_DONGLE

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# ペリフェラル 2 台 + PC 用の接続先 5 つ
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif # SHIELD_TIMOTHY_V2_DONGLE
