#include <dt-bindings/zmk/matrix_transform.h>

#include "timothy_v2-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &default_layout;
        zmk,battery = &aaa_battery;
    };

    // 単4アルカリ乾電池 1 本の電圧を D0 (P0.02 = AIN0) に直接入力して残量を測る。
    aaa_battery: aaa_battery {
        compatible = "timothy,battery-alkaline";
        io-channels = <&adc 0>;
        cells = <1>;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&xiao_d 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row-0: D10
            , <&xiao_d 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row-1: D7
            , <&xiao_d 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row-2: D8
            , <&xiao_d 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row-3: D9
            ;
    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <4>;

        // 一番外側の列 (左 col-0 / 右 col-13、どちらも D2) は基板上で
        // スイッチが 1 段下の row に配線されているため、row を 1 つずらして読む。
        //   物理 1 段目 → row-1, 2 段目 → row-2, 3 段目 → row-3, 4 段目 → row-0
        map = <
            RC(1,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)    RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(1,13)
            RC(2,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)    RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(2,13)
            RC(3,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)    RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(3,13)
            RC(0,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)    RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(0,13)
        >;
    };
};

// XIAO 内蔵のリチウムイオン用電圧測定 (P0.31) は使わないので無効化する。
&vbatt {
    status = "disabled";
};

// 右の隠しキーの &soft_off で電源を切ったあと、マトリックスのどのキーを押しても起動できるようにする。
/ {
    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources = <&kscan>;
    };
};
