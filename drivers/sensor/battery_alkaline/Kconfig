DT_COMPAT_TIMOTHY_BATTERY_ALKALINE := timothy,battery-alkaline

config TIMOTHY_BATTERY_ALKALINE
    bool "Alkaline cell battery monitoring (direct ADC input)"
    default $(dt_compat_enabled,$(DT_COMPAT_TIMOTHY_BATTERY_ALKALINE))
    select ADC
    select ZMK_BATTERY
    depends on SENSOR
    help
        Measure an alkaline cell connected directly to an ADC pin and
        convert the voltage to state of charge with an alkaline discharge curve.
